# ==============================================================================
# RUMIDENTAL - ENVIRONMENT CONFIGURATION (SUPABASE POSTGRESQL & BACKEND)
# ==============================================================================

# 1. Django Settings
DJANGO_SECRET_KEY=django-insecure-rumidental-supabase-prod-secret-key-2026
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost,.vercel.app,.supabase.co

# 2. Supabase PostgreSQL Database Connection
# Paste your Supabase Connection String below (found in Supabase Dashboard -> Settings -> Database -> Connection string -> URI / Pooled / Direct)
# Format: postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?sslmode=require
DATABASE_URL=

# 3. CORS Settings (Frontend domains allowed to talk to Django API)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://rumidentalcare.vercel.app
CORS_ALLOW_ALL_ORIGINS=True
