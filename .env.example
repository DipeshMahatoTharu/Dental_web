# Django Security & Core Settings
DJANGO_SECRET_KEY=replace-with-a-secure-random-secret-key
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost,.vercel.app,.supabase.co

# CORS Settings (comma-separated origins)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://rumidentalcare.vercel.app

# Supabase PostgreSQL Database Settings
# Direct Connection: postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres
# Or Transaction Pooler: postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres
DATABASE_URL=postgresql://postgres:your-supabase-db-password@db.yourprojectref.supabase.co:5432/postgres
